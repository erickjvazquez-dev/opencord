# Copy to .env and adjust. Loaded automatically by `go run ./cmd/server`
# (via godotenv) and by docker-compose.

# Secret used to sign JWTs. CHANGE THIS for anything beyond local dev.
JWT_SECRET=change-me-to-a-long-random-string

# Postgres connection. The default matches docker-compose's db service when run
# locally; inside compose the server uses the internal hostname `db`.
DATABASE_URL=postgres://opencord:opencord@localhost:5432/opencord?sslmode=disable

# Address the server listens on.
OPENCORD_ADDR=:8080

# Allowed CORS origin for the REST API ("*" is fine for local dev).
CORS_ORIGIN=*

# Optional OSS SFU (LiveKit) for large voice calls. Leave all three empty (the
# default) and voice stays peer-to-peer mesh — the one-command stack needs no SFU.
# Set them only if you self-host LiveKit and want calls to scale past a handful.
# OPENCORD_SFU_URL=wss://your-livekit-host
# OPENCORD_SFU_KEY=
# OPENCORD_SFU_SECRET=

# --- Voice across hostile/symmetric NATs: optional TURN relay ---------------------
# STUN (NAT discovery only, no media relay). Defaults to a public Google STUN; override
# with your own to depend on no third party.
# OPENCORD_STUN_URL=stun:stun.l.google.com:19302

# TURN media relay. Empty (default) ⇒ STUN-only mesh. Point at your relay, e.g. the
# bundled coturn: turn:<this-host-ip>:3478
# OPENCORD_TURN_URL=

# Ephemeral TURN auth (RECOMMENDED — coturn `use-auth-secret`/REST scheme): when set, the
# server mints SHORT-LIVED per-user HMAC credentials (a leaked cred expires) instead of a
# static user/pass. Use the SAME secret on coturn (the bundled `turn` profile reads it).
# Generate: `openssl rand -hex 32`.
# OPENCORD_TURN_SECRET=
# How long each minted credential is valid (Go duration; default 12h).
# OPENCORD_TURN_TTL=12h
# Static TURN auth — use ONLY if you do not set OPENCORD_TURN_SECRET above.
# OPENCORD_TURN_USERNAME=
# OPENCORD_TURN_PASSWORD=

# To run the bundled coturn relay (Linux + host networking):
#   1. set OPENCORD_TURN_SECRET (+ OPENCORD_TURN_URL=turn:<this-host>:3478)
#   2. `docker compose --profile turn up`
# The `turn` profile is OFF by default, so a plain `docker compose up` stays TURN-free.
